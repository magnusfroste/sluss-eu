ROUTER_ADDR=:8080
MOCK_PROVIDER_ADDR=:18080
MOCK_PROVIDER_URL=http://localhost:18080
LOCAL_API_KEY=local_router_key
# OpenRouter (real OpenAI-compatible provider). When set, the router uses the
# OpenRouter registry instead of the mock provider. Leave empty to use the mock.
OPENROUTER_API_KEY=
# Optional OpenRouter attribution headers (HTTP-Referer / X-Title) for app ranking.
OPENROUTER_REFERER=
OPENROUTER_TITLE=
# Model roster: which OpenRouter model fills each routing tier. Use OpenRouter
# slugs (e.g. z-ai/glm-4.6, openai/gpt-4o-mini). Empty keeps the built-in
# default. Routing (task -> tier) is unchanged; this only swaps the model.
# LEGACY (ISSUE-073): the roster now lives in SQLite (history.db under
# ROUTER_DATA_DIR) and is edited on the Models admin page. When a data dir is
# set these values are written through to the DB at startup (so the persisted
# roster and routing stay in sync); prefer the Models page over these env vars.
ROUTER_MODEL_CHEAP=
ROUTER_MODEL_BALANCED=
ROUTER_MODEL_PREMIUM=
DATABASE_URL=postgres://tokenizer:tokenizer@localhost:5432/tokenizer?sslmode=disable
LOG_LEVEL=info
# Dashboard/console password. With a data dir set, this is the BREAK-GLASS login
# (username can be anything) alongside named users on the Users page — so an
# operator can never be locked out. Without a data dir it's plain HTTP Basic Auth.
ROUTER_DASHBOARD_PASSWORD=
# Named-user console (accountability): seed an initial admin account from these
# on first boot (when the user table is empty), so console actions are audited
# per person. After that, manage users on the Users page. Break-glass above stays.
ROUTER_ADMIN_USER=
ROUTER_ADMIN_PASSWORD=
# Persistence: ABSOLUTE directory on a (mounted) volume where durable history +
# spend/savings live so the dashboard survives restarts/redeploys. Empty =
# in-memory only. On a container use the volume mount path (e.g. /data) — a
# relative path lands in the ephemeral filesystem and is lost on redeploy.
ROUTER_DATA_DIR=
# Retention/privacy (ISSUE-045)
ROUTER_RETENTION_DAYS=30
ROUTER_RETENTION_INTERVAL_HOURS=24
# Prompt logging is OFF by default; only enable for debugging.
ROUTER_PROMPT_LOGGING=false
# Budget caps (ISSUE-051). 0 disables; sets a per-tenant cap (USD) for tn_local.
ROUTER_BUDGET_USD=0
# Route decision cache (ISSUE-052). 0 disables; TTL for cached low-risk decisions.
ROUTER_DECISION_CACHE_TTL_SECONDS=60
# Provider circuit breaker. After this many CONSECUTIVE failures a provider's
# circuit opens: it is excluded from routing (forcing fallback to a healthy
# provider) until the cooldown elapses, then a single probe re-checks it.
# Set threshold to 0 to disable breaking (rolling-window health only).
ROUTER_CIRCUIT_BREAKER_THRESHOLD=5
ROUTER_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# Global conservative mode (ISSUE-060). Incident lever: route uncertain
# classifications at >= balanced. See 07-operations/runbook.md.
ROUTER_CONSERVATIVE_MODE=false
# Eval-driven scoring: path to an eval report (from `make eval-report`) whose
# measured pass rates override static quality priors in routing. Empty = off.
ROUTER_MEASURED_QUALITY_REPORT=
# Minimum eval samples a model needs for its measured quality to be used.
ROUTER_MEASURED_QUALITY_MIN_SAMPLES=1
# Runtime policy. Empty uses the built-in default policy. Forms:
#   (empty)               -> built-in default (no PII->local rule)
#   builtin:pii-local     -> embedded PII-stays-local policy (no file needed)
#   builtin:nis2-baseline -> embedded NIS2/cybersäkerhetslagen starter ruleset
#                            (personal data + secrets stay local, security_review
#                            fail-closed, else cloud). A CISO starting point to
#                            adapt. See 00-product/09-nis2-routing-controls.md.
#   /data/my-policy.yaml  -> a YAML file on a MOUNTED volume (a bare relative path
#                            like policies/x.yaml will NOT resolve — the runtime
#                            image ships only the binary, not the repo)
# Shadow is disabled unless ROUTER_SHADOW_POLICY_PATH is set (same forms).
# MONITOR MODE (ISSUE-095, the CISO hook): run a compliance pack as the SHADOW
# policy — nothing blocks, nothing changes for users, but /router/gap-report
# counts what the pack WOULD have done with sensitive prompts ("N prompts with
# personal data went to cloud; under the pack 100% had stayed local"). Convert
# to enforcement by moving the pack to ROUTER_POLICY_PATH.
#   ROUTER_SHADOW_POLICY_PATH=builtin:nis2-baseline
ROUTER_POLICY_PATH=
ROUTER_SHADOW_POLICY_PATH=
# Regime profile (ISSUE-094): flavours the control report + public label per
# market/regime — nis2 | dora | gdpr | eu. Empty derives it from the active
# policy pack (builtin:nis2-baseline -> nis2, dora-baseline -> dora, ...).
# Words only — routing rules come from the policy pack above.
ROUTER_PROFILE=
# Context processors are still policy-gated; this is only an operator rollout /
# kill switch. Prompt adapters are disabled unless explicitly enabled.
ROUTER_CONTEXT_PIPELINE_ENABLED=false
ROUTER_PROMPT_ADAPTER_ENABLED=false
# Green receipt: grid carbon intensity (grams CO2e per kWh) used to convert the
# dashboard's estimated energy savings to CO2e. Default 400 (world average);
# EU grid is closer to 250.
ROUTER_GRID_CO2E_G_PER_KWH=400
# Live model pricing: sync per-model prices from OpenRouter's /models catalog at
# startup so estimates/savings/scoring stay current (realized cost is always
# exact from usage regardless). Set to false to keep hardcoded/manual prices.
ROUTER_PRICING_SYNC=true
# Read-only MCP surface (ISSUE-074). When true, mounts POST /mcp on the router so
# agents can introspect routing decisions (route_explain) and query spend /
# roster / health. OFF by default. Gated behind the same Bearer API key or
# ROUTER_DASHBOARD_PASSWORD as the rest. See docs/mcp.md. For local dev agents
# (e.g. Claude Code) build the stdio binary instead: `go build ./cmd/mcp`.
ROUTER_MCP_ENABLED=false
# MCP write surface (ISSUE-091). When true, additionally exposes the MUTATING MCP
# tools so an agent can drive prospect outreach: mint_key (per-prospect key),
# revoke_key, create_demo_link. The usage tools (key_usage, demo_link_usage) are
# always available when MCP is on. OFF by default — the surface stays read-only
# unless you opt in. Still admin-gated and audited. Requires ROUTER_MCP_ENABLED.
ROUTER_MCP_WRITE_ENABLED=false
# Public base URL of the deployed site (no trailing slash). Used for the public
# landing page's canonical/OpenGraph tags and the sitemap. Empty = relative
# links, no canonical (fine for local/dev). e.g. https://tokenizer.example.com
ROUTER_PUBLIC_URL=
# Council mode (Fusion-inspired). Comma-separated task classes that deliberate
# across a panel of the top-N routed models (run concurrently) and return the
# consensus answer, instead of trusting one model. Slow path, non-streaming
# only. Empty disables it. More reliable but N× the cost — reserve for
# high-risk classes. e.g. security_review,database_migration,unknown_high_risk
ROUTER_COUNCIL_TASKS=
# Max panel size (distinct models drawn from the routed fallback chain).
ROUTER_COUNCIL_SIZE=3
# Live policy A/B (Fas 4). Serve an experiment policy variant to a deterministic
# share of traffic, bucketed by tenant+project so a tenant's arm is stable. The
# assigned arm is returned as X-Router-Experiment-Arm and tagged on the decision
# event so outcomes can be sliced by arm. Empty path or 0% disables it.
ROUTER_EXPERIMENT_POLICY_PATH=
ROUTER_EXPERIMENT_PERCENTAGE=0
# Salt rotates/isolates the assignment: change it to reshuffle which tenants land
# in treatment without changing the percentage.
ROUTER_EXPERIMENT_SALT=
# Bandit routing (Fas 4). Learn per-(task, model) which model actually delivers
# from realized outcomes and feed it into scoring (UCB1, deterministic — no RNG).
# Supersedes the static measured-quality source when on; warm-starts from the
# measured report if one is set. Off by default.
ROUTER_BANDIT_ENABLED=false
# UCB1 exploration weight (higher = explore more; classic sqrt(2)≈1.41).
ROUTER_BANDIT_EXPLORATION=1.41

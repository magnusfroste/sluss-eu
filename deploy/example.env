# Sluss — example environment for EasyPanel / docker compose / docker run.
# Copy the lines you need into the service's env field in EasyPanel.
# Only LOCAL_API_KEY is required; everything else has a safe default.

# --- Auth (REQUIRED) ---------------------------------------------------------
# Clients send this as `Authorization: Bearer <key>`. Use a strong secret:
#   openssl rand -hex 24
LOCAL_API_KEY=

# --- Provider ----------------------------------------------------------------
# Set OPENROUTER_API_KEY to reach cloud models through OpenRouter. Optional:
# models on your own hardware are added in the console (Quick start), with or
# without a key. Until a real model is connected, a built-in test answer says so.
OPENROUTER_API_KEY=
# Optional OpenRouter attribution (app ranking):
OPENROUTER_REFERER=
OPENROUTER_TITLE=

# --- Model roster (optional) -------------------------------------------------
# Which OpenRouter model fills each routing tier. Use OpenRouter slugs (the
# exact "provider/model" names OpenRouter lists, e.g. z-ai/glm-4.6,
# openai/gpt-4o-mini, anthropic/claude-sonnet-4.5). Empty keeps the built-in
# default. Routing logic (task → tier) is unchanged; this only swaps the model.
# Note: realized cost stays accurate from usage, but cost *estimates* and the
# savings baseline use the registry's pricing for that tier.
ROUTER_MODEL_CHEAP=
ROUTER_MODEL_BALANCED=
ROUTER_MODEL_PREMIUM=

# --- Cost guard --------------------------------------------------------------
# Per-tenant spend cap in USD; 0 disables. When exceeded the router downgrades.
ROUTER_BUDGET_USD=0

# --- Privacy / retention -----------------------------------------------------
ROUTER_PROMPT_LOGGING=false
ROUTER_RETENTION_DAYS=30

# --- Incident lever ----------------------------------------------------------
# Route uncertain classifications at >= balanced (see 07-operations/runbook.md).
ROUTER_CONSERVATIVE_MODE=false

# --- Persistence -------------------------------------------------------------
# Absolute directory on the mounted volume where durable history + spend/savings
# live so the dashboard survives restarts/redeploys. MUST be an absolute path
# that matches the volume mount — the compose file mounts the named volume
# `tokenizer-data` at /data, so keep this /data. A relative path (e.g. app/data)
# lands in the container's ephemeral filesystem and is lost on redeploy.
ROUTER_DATA_DIR=/data

# --- Break-glass login -------------------------------------------------------
# This password opens /router/login with any username, so an operator is never
# locked out. Such a session is audited as "break-glass". Use a long passphrase
# and keep it for emergencies; everyday sign-in is a named account (below).
ROUTER_DASHBOARD_PASSWORD=

# --- Networking / logging (usually leave as default) -------------------------
APP_BIND=0.0.0.0
APP_PORT=8080
LOG_LEVEL=info

# --- Green receipt -------------------------------------------------------------
# Grid carbon intensity (g CO2e/kWh) for the dashboard's estimated energy line.
ROUTER_GRID_CO2E_G_PER_KWH=400

# Price list from OpenRouter at startup (false = keep manual prices; set false
# on air-gapped installs).
ROUTER_PRICING_SYNC=true

# --- Console admin (named user, seeded once when no user exists) ------------
# Read only while the user table is empty. After the first start the account
# lives in the database: change the password on /me (Your profile) and manage
# accounts under Access -> Console users. Editing these later changes nothing.
ROUTER_ADMIN_USER=
ROUTER_ADMIN_PASSWORD=

# --- Policy pack -------------------------------------------------------------
# e.g. builtin:nis2-baseline, builtin:dora-baseline, builtin:gdpr-sovereign,
# builtin:pii-local. Empty keeps the default policy.
ROUTER_POLICY_PATH=
# Monitor mode: run a pack as the SHADOW policy. Nothing blocks, but
# /router/gap-report counts what the pack would have done. Same forms as above.
ROUTER_SHADOW_POLICY_PATH=
# Wording of the control report per regime: nis2 | dora | gdpr | eu.
# Empty derives it from the active pack.
ROUTER_PROFILE=

# --- Second opinion (ISSUE-163) ---------------------------------------------
# A model on your own hardware that may only make a decision STRICTER: the
# rules decide first; the model may add a class they did not see (a name with
# context, an illness in plain words, a deal without a financial term), never
# remove one. Give the roster id of a model tagged local (Models page); a
# cloud model is refused. Empty = off. The call is bounded by the timeout;
# past it the rules' decision stands alone.
ROUTER_SECOND_OPINION_MODEL=
ROUTER_SECOND_OPINION_TIMEOUT=500ms

# Names in free text ("our customer Karl Öberg") are personal data, found by a
# rule: a given name from a fixed list followed by a family name. It cannot
# tell a customer from an author, so a question about Astrid Lindgren is kept
# on your own models too. "off" turns the rule off; identifiers are unaffected.
ROUTER_NAME_DETECTION=on

# --- Audit anchor ------------------------------------------------------------
# Every interval Sluss logs an "audit anchor" line: seq and hash of the chain's
# last record. Shipped with the log to a SIEM, it proves an export was not
# rewritten (audit-verify -anchor). A Go duration, e.g. 1h, 15m; off disables.
ROUTER_AUDIT_ANCHOR_INTERVAL=1h

# The audit log grows for ever. At this size (in MB) the file is sealed: it
# gets a last record, moves to audit-archive in the data directory, read-only,
# and the log continues in a new file as the same chain. Nothing is deleted;
# the export still gives the whole log from the first record. 0 = never.
ROUTER_AUDIT_ROTATE_MB=0

# --- Monitoring --------------------------------------------------------------
# /metrics needs a key: the console gate (a signed-in admin, an admin key, the
# break-glass password) or this separate bearer token for the scraper, so
# Prometheus never holds an admin key. Empty = only the console gate.
#   openssl rand -hex 24
ROUTER_METRICS_TOKEN=

# --- Agents (MCP) ------------------------------------------------------------
# true mounts a read-only MCP surface on POST /mcp (route_explain, savings,
# recent requests, roster, health), behind the same keys. See docs/mcp.md.
ROUTER_MCP_ENABLED=false

# --- Public base URL ---------------------------------------------------------
# The HTTPS address users reach (e.g. https://sluss.example.eu); used for
# shareable demo links. Optional.
ROUTER_PUBLIC_URL=

# --- Sign in with the company account (ISSUE-130) ---------------------------
# Sluss is an OpenID Connect client against your IdP (Microsoft Entra ID, Okta,
# Google Workspace, Keycloak): employees sign in with the company account and
# need no Sluss password. (Administrators may also have local console accounts.)
# Register a web app at the IdP with redirect URI
#   <ROUTER_PUBLIC_URL>/router/oidc/callback
# Both ISSUER and CLIENT_ID enable it; needs ROUTER_DATA_DIR (DB-backed sessions).
#   Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
#   Okta:            https://<org>.okta.com   (add "groups" to SCOPES)
#   Google:          https://accounts.google.com (no groups; use ALLOWED_DOMAINS)
#   Keycloak:        https://<host>/realms/<realm>
ROUTER_OIDC_ISSUER=
ROUTER_OIDC_CLIENT_ID=
# Optional: empty = public client (PKCE only).
ROUTER_OIDC_CLIENT_SECRET=
# Scopes (default: openid profile email). Okta: "openid profile email groups".
ROUTER_OIDC_SCOPES=
# ID-token claim that lists the user's groups (default: groups). Entra sends
# group object IDs unless the app is configured for names.
ROUTER_OIDC_GROUPS_CLAIM=
# Members of these groups get the admin console; everyone else is chat-only.
ROUTER_OIDC_ADMIN_GROUPS=
# group=department pairs: the department (tenant) an employee's chat is logged
# under, e.g. "grp-finance=finance,grp-hr=hr". Unmapped users: DEFAULT_DEPARTMENT.
ROUTER_OIDC_DEPARTMENTS=
ROUTER_OIDC_DEFAULT_DEPARTMENT=sso
# Only these email domains may sign in (comma-separated). Empty = any the IdP
# authenticates.
ROUTER_OIDC_ALLOWED_DOMAINS=
# Button text: "Sign in with <label>".
ROUTER_OIDC_LABEL=

# --- Chat web search (ISSUE-129) ---------------------------------------------
# A SearXNG-compatible search endpoint (?q=…&format=json) the company chat may
# query when the user turns on 🌐. Self-host SearXNG so a query never becomes
# someone else's data. The prompt is classified first: personal, financial,
# health, legal, security or secret-looking content never reaches the engine.
# Empty = the toggle is off.
ROUTER_SEARCH_URL=

# --- Version check (ISSUE-138) -----------------------------------------------
# Sluss asks the public GitHub API every 6 hours whether a newer release is out
# (a build from main compares with main), and shows it on the Version page (the
# version in the menu footer). Nothing about this instance is sent. "off" for
# air-gapped installs.
ROUTER_UPDATE_CHECK=on
# How this instance is deployed, so the Version page shows your upgrade step
# first: docker | compose | easypanel | agenthotel
ROUTER_DEPLOYMENT=

# --- Boot banner (ISSUE-141) -------------------------------------------------
# On start Sluss prints a short banner to stderr (version, commit, console URL,
# data dir) plus one JSON "sluss ready" line. "off" keeps the log JSON-only.
ROUTER_LOG_BANNER=on

# Tuning and experimental settings (circuit breaker, decision cache, council
# mode, policy A/B, bandit routing, measured quality) are documented in
# .env.example at the repository root. Their defaults are right for production.

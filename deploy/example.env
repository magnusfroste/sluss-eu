# Sluss — example environment for EasyPanel / docker compose / docker run.
# Copy the lines you need into the service's env field in EasyPanel.
# Only LOCAL_API_KEY is required; everything else has a safe default.

# --- Auth (REQUIRED) ---------------------------------------------------------
# Clients send this as `Authorization: Bearer <key>`. Use a strong secret:
#   openssl rand -hex 24
LOCAL_API_KEY=

# --- Provider ----------------------------------------------------------------
# Set OPENROUTER_API_KEY to route through OpenRouter (a real OpenAI-compatible
# aggregator). Leave blank to fall back to the in-process mock provider.
OPENROUTER_API_KEY=
# Optional OpenRouter attribution (app ranking):
OPENROUTER_REFERER=
OPENROUTER_TITLE=

# --- Model roster (optional) -------------------------------------------------
# Which OpenRouter model fills each routing tier. Use OpenRouter slugs (the
# exact "provider/model" names OpenRouter lists, e.g. z-ai/glm-4.6,
# openai/gpt-4o-mini, anthropic/claude-sonnet-4.5). Empty keeps the built-in
# default. Routing logic (task → tier) is unchanged; this only swaps the model.
# Note: realized cost stays accurate from usage, but cost *estimates* and the
# savings baseline use the registry's pricing for that tier.
ROUTER_MODEL_CHEAP=
ROUTER_MODEL_BALANCED=
ROUTER_MODEL_PREMIUM=

# --- Cost guard --------------------------------------------------------------
# Per-tenant spend cap in USD; 0 disables. When exceeded the router downgrades.
ROUTER_BUDGET_USD=0

# --- Privacy / retention -----------------------------------------------------
ROUTER_PROMPT_LOGGING=false
ROUTER_RETENTION_DAYS=30

# --- Incident lever ----------------------------------------------------------
# Route uncertain classifications at >= balanced (see 07-operations/runbook.md).
ROUTER_CONSERVATIVE_MODE=false

# --- Persistence -------------------------------------------------------------
# Absolute directory on the mounted volume where durable history + spend/savings
# live so the dashboard survives restarts/redeploys. MUST be an absolute path
# that matches the volume mount — the compose file mounts the named volume
# `tokenizer-data` at /data, so keep this /data. A relative path (e.g. app/data)
# lands in the container's ephemeral filesystem and is lost on redeploy.
ROUTER_DATA_DIR=/data

# --- Dashboard ---------------------------------------------------------------
# Set a password to open /router/dashboard directly in a browser (Basic Auth):
# the browser shows a login prompt. Leave blank to keep the Bearer + admin gate.
ROUTER_DASHBOARD_PASSWORD=

# --- Networking / logging (usually leave as default) -------------------------
APP_BIND=0.0.0.0
APP_PORT=8080
LOG_LEVEL=info

# --- Green receipt -------------------------------------------------------------
# Grid carbon intensity (g CO2e/kWh) for the dashboard's estimated energy line.
ROUTER_GRID_CO2E_G_PER_KWH=400

# Live pricing sync from OpenRouter at startup (false = keep manual prices).
ROUTER_PRICING_SYNC=true

# --- Console admin (named user, seeded once when no user exists) ------------
ROUTER_ADMIN_USER=
ROUTER_ADMIN_PASSWORD=

# --- Policy pack -------------------------------------------------------------
# e.g. builtin:nis2-baseline, builtin:dora-baseline, builtin:gdpr-sovereign,
# builtin:pii-local. Empty keeps the default policy.
ROUTER_POLICY_PATH=

# --- Public base URL ---------------------------------------------------------
# The HTTPS address users reach (e.g. https://sluss.example.eu); used for
# shareable demo links. Optional.
ROUTER_PUBLIC_URL=

# --- Sign in with the company account (ISSUE-130) ---------------------------
# Sluss is an OpenID Connect client against your IdP (Microsoft Entra ID, Okta,
# Google Workspace, Keycloak) and keeps no employee accounts of its own.
# Register a web app at the IdP with redirect URI
#   <ROUTER_PUBLIC_URL>/router/oidc/callback
# Both ISSUER and CLIENT_ID enable it; needs ROUTER_DATA_DIR (DB-backed sessions).
#   Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
#   Okta:            https://<org>.okta.com   (add "groups" to SCOPES)
#   Google:          https://accounts.google.com (no groups; use ALLOWED_DOMAINS)
#   Keycloak:        https://<host>/realms/<realm>
ROUTER_OIDC_ISSUER=
ROUTER_OIDC_CLIENT_ID=
# Optional: empty = public client (PKCE only).
ROUTER_OIDC_CLIENT_SECRET=
# Scopes (default: openid profile email). Okta: "openid profile email groups".
ROUTER_OIDC_SCOPES=
# ID-token claim that lists the user's groups (default: groups). Entra sends
# group object IDs unless the app is configured for names.
ROUTER_OIDC_GROUPS_CLAIM=
# Members of these groups get the admin console; everyone else is chat-only.
ROUTER_OIDC_ADMIN_GROUPS=
# group=department pairs: the department (tenant) an employee's chat is logged
# under, e.g. "grp-finance=finance,grp-hr=hr". Unmapped users: DEFAULT_DEPARTMENT.
ROUTER_OIDC_DEPARTMENTS=
ROUTER_OIDC_DEFAULT_DEPARTMENT=sso
# Only these email domains may sign in (comma-separated). Empty = any the IdP
# authenticates.
ROUTER_OIDC_ALLOWED_DOMAINS=
# Button text: "Sign in with <label>".
ROUTER_OIDC_LABEL=

# --- Chat web search (ISSUE-129) ---------------------------------------------
# A SearXNG-compatible search endpoint (?q=…&format=json) the company chat may
# query when the user turns on 🌐. Self-host SearXNG so a query never becomes
# someone else's data. The prompt is classified first: personal, financial,
# health, legal, security or secret-looking content never reaches the engine.
# Empty = the toggle is off.
ROUTER_SEARCH_URL=

# --- Version check (ISSUE-138) -----------------------------------------------
# Sluss asks the public GitHub API every 6 hours whether a newer version is on
# main, and shows it on the Version page (the version in the menu footer).
# Nothing about this instance is sent. "off" for air-gapped installs.
ROUTER_UPDATE_CHECK=on
# How this instance is deployed, so the Version page shows your upgrade step
# first: docker | compose | easypanel | agenthotel
ROUTER_DEPLOYMENT=
